# .env.example — copie para ".env" (na mesma pasta) e preencha.
# Os dados do banco são os criados no cPanel > Bancos de dados MySQL.

DB_HOST=localhost
DB_NAME=usuario_planner
DB_USER=usuario_planner
DB_PASS=

# production = erros vão para logs/php-error.log e não aparecem na tela
APP_ENV=production

# ----- Controle de acesso -----
# Endereço público do planner, sem barra no final. Tem que ser igual ao cadastrado no Google.
APP_URL=https://sist.cecapescs.com.br/planner

# Domínio das contas institucionais que podem entrar pelo Google.
AUTH_DOMAIN=scseduca.com.br

# Credencial criada no Google Cloud (APIs e serviços > Credenciais > ID do cliente OAuth).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Opcional: contas Google de fora do domínio que também podem entrar, separadas por vírgula.
# Só funciona se a tela de consentimento do Google for do tipo "Externo".
AUTH_EXTRA_EMAILS=
