# .env.example — copie para ".env" (na mesma pasta) e preencha.
# Os dados do banco são os criados no cPanel > Bancos de dados MySQL.

DB_HOST=localhost
DB_NAME=usuario_planner
DB_USER=usuario_planner
DB_PASS=

# production = erros vão para logs/php-error.log e não aparecem na tela
APP_ENV=production
